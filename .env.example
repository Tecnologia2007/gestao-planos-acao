# Copie este arquivo para .env.local. Nunca commite o arquivo preenchido.
# A chave anon (pública) pode ir no navegador. A service role, a chave de
# criptografia, o segredo do cron e a chave do Resend ficam só no servidor.

# URL e chave anon do NOVO projeto Supabase (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon

# Segredo. Nunca use prefixo NEXT_PUBLIC_. Nunca cole no front-end.
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role

# Cifra notas sigilosas (AES-256-GCM) antes de gravar. Gere com:
# openssl rand -base64 32
ENCRYPTION_KEY=troque_por_uma_chave_longa_e_aleatoria

# Resend. O remetente precisa ser de um domínio verificado.
RESEND_API_KEY=re_sua_chave
RESEND_FROM_EMAIL="Cicobi Auditorias <auditoria@seudominio.com.br>"

# E-mail do Tony, sempre incluído nos alertas de prazo.
ADMIN_EMAIL=tony@seudominio.com.br

# URL pública da aplicação (local ou Vercel), sem barra no final.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# A Vercel envia este valor como "Authorization: Bearer ...". Mínimo de 16 caracteres.
# openssl rand -base64 32
CRON_SECRET=troque_por_um_segredo_longo

# Encerra a sessão após este número de minutos sem uso (entre 5 e 720).
SESSION_INACTIVITY_MINUTES=30
